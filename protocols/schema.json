{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andysu/can2din/protocols/schema.json",
  "title": "can2din vehicle protocol profile",
  "type": "object",
  "required": ["schema_version", "vehicle", "canbox", "status", "frames"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "vehicle": {
      "type": "object",
      "required": ["make", "model", "years"],
      "properties": {
        "make": { "type": "string" },
        "model": { "type": "string" },
        "generation": { "type": "string" },
        "years": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "canbox": {
      "type": "object",
      "required": ["vendor"],
      "properties": {
        "vendor": { "type": "string", "enum": ["raise", "hiworld", "simplesoft", "other"] },
        "fyt_callback": { "type": ["string", "null"] }
      }
    },
    "status": { "type": "string", "enum": ["draft", "partial", "verified"] },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cmd_type", "name", "fields"],
        "properties": {
          "cmd_type": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{2}$" },
          "name": { "type": "string" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "byte"],
              "properties": {
                "name": { "type": "string" },
                "byte": { "type": "integer", "minimum": 0 },
                "bit": { "type": "integer", "minimum": 0, "maximum": 7 },
                "length_bits": { "type": "integer", "minimum": 1 },
                "scale": { "type": "number" },
                "offset": { "type": "number" },
                "unit": { "type": "string" },
                "update_code": { "type": ["integer", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
